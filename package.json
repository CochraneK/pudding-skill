{
	"name": "pudding-skill",
	"version": "2.6.0",
	"private": true,
	"description": "Pudding-inspired editorial data-storytelling agent skill with candidate ranking, claim auditing, data contracts, visual grammar, first-draft generation, and browser QA",
	"scripts": {
		"gdoc": "node tasks/fetch-google.js",
		"style": "node tasks/style-dictionary.js",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "prettier --check --plugin-search-dir=. .",
		"format": "prettier --write --plugin-search-dir=. .",
		"check:skill": "python scripts/data_contract.py examples/data-schema.example.json && python scripts/validate_story.py examples/story-spec.example.json && python scripts/pipeline.py examples/sample-data.csv --schema examples/data-schema.example.json --question \"Which fictional cities saw housing costs separate most sharply from income after 2019?\" && python -m unittest discover -s tests -p 'test_*.py' && python scripts/pudding_corpus.py validate && python scripts/concept_board.py validate stories/global-mental-health/concept-board.json && python scripts/qa_story.py --root .",
		"benchmark": "python scripts/benchmark.py",
		"story:derive": "python scripts/derive_story.py",
		"story:build": "python scripts/pipeline.py",
		"story:qa": "python scripts/qa_story.py --root .",
		"story:visual": "python scripts/visual_grammar.py",
		"story:draft": "python scripts/draft_story.py",
		"pudding": "python scripts/pudding.py",
		"pudding:study": "python scripts/pudding_corpus.py report",
		"pudding:concept": "python scripts/concept_board.py",
		"test:skill": "python -m unittest discover -s tests -p 'test_*.py'",
		"story:candidates": "python scripts/candidate_story.py",
		"story:select": "python scripts/select_story.py",
		"story:evaluate": "python scripts/evaluate_story.py",
		"story:verify": "python scripts/verify_claims.py",
		"qa:browser": "node scripts/browser_qa.mjs",
		"qa:visual-probe": "node scripts/visual_probe.mjs",
		"qa:visual": "python scripts/visual_critic.py .qa/visual-probe.json --output .qa/visual-review.json --markdown .qa/visual-review.md --fail-on error",
		"visual:refine": "python scripts/refine_visual.py .qa/visual-review.json"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.16.0",
		"@rollup/plugin-dsv": "^3.0.5",
		"@sveltejs/adapter-cloudflare": "^7.2.6",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.60.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"archieml": "^0.5.0",
		"autoprefixer": "^10.5.0",
		"bits-ui": "^2.18.1",
		"d3": "^7.9.0",
		"lodash.debounce": "^4.0.8",
		"postcss": "^8.5.15",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.2",
		"rollup": "^4.60.4",
		"rollup-plugin-svg": "^2.0.0",
		"runed": "^0.37.1",
		"style-dictionary": "^5.4.1",
		"svelte": "^5.55.9",
		"svelte-preprocess": "^6.0.3",
		"typescript": "^5.9.3",
		"vite": "^8.0.13",
		"vite-plugin-svgstring": "^1.0.0"
	},
	"type": "module",
	"engines": {
		"node": ">= 22.22.0"
	},
	"browserslist": "> 0.5%, last 4 versions, not ie <= 11, not ie_mob <= 11"
}
